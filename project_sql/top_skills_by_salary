WITH merge_table AS (
SELECT
    skills,
    salary_year_avg
FROM job_postings_fact
INNER JOIN skills_job_dim ON job_postings_fact.job_id = skills_job_dim.job_id
INNER JOIN skills_dim ON skills_job_dim.skill_id = skills_dim.skill_id
WHERE
    job_title_short = 'Data Analyst' AND
    salary_year_avg IS NOT NULL AND
    job_work_from_home = TRUE
ORDER BY salary_year_avg DESC
)
SELECT
    skills,
    ROUND(AVG(salary_year_avg), 0) as avg_skill_salary
FROM merge_table
GROUP BY skills
ORDER BY avg_skill_salary DESC
LIMIT 10



/*- **PySpark has the highest average salary ($208K)**, followed by Bitbucket ($189K) and Watson ($161K).
- The list highlights **advanced data, programming, cloud, and machine-learning tools**, such as PySpark, Pandas, Jupyter, and DataRobot.
- **Pandas and PySpark are particularly relevant to data analysts**, showing that Python-based data processing skills can be associated with higher-paying roles.
*/

WITH average_salary AS (
