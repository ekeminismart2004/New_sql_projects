SELECT *
FROM (
    SELECT *
    FROM job_postings_fact
    WHERE
    EXTRACT(MONTH FROM job_posted_date) = 1
) AS january_jobs



SELECT job_no_degree_mention
FROM job_postings_fact


SELECT 
    company_id,
    name AS company_name
FROM company_dim
WHERE company_id IN (
    SELECT company_id
    FROM job_postings_fact
    WHERE job_no_degree_mention = true
    ORDER BY 
        company_id
)

WITH company_job_count AS(
    SELECT COUNT(job_id) AS total,
        company_id
    FROM job_postings_fact
    GROUP BY
        company_id
)
SELECT
    company_dim.name,
    company_job_count.total
FROM company_dim
LEFT JOIN company_job_count ON company_dim.company_id = company_job_count.company_id
ORDER BY company_job_count.total DESC